@model List<TodoItem>

<h2>Yapılacaklar Listesi</h2>

<a asp-action="Create" class="btn btn-success mb-3">Yeni Ekle</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Durum</th>
            <th>Oluşturulma Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@(item.IsCompleted ? "Tamamlandı" : "Bekliyor")</td>
            <td>@item.CreatedDate.ToString("g")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Düzenle</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
            </td>
        </tr>
    }
    </tbody>
</table>